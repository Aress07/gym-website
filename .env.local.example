# Copy this file to `.env.local` and fill in the values.
# Both are public (bundled in the client) — treat them as access tokens,
# not as secrets that hide the endpoint.

# URL of the deployed Apps Script Web App (/exec), set in step 5 of
# docs/reservation-setup.md
NEXT_PUBLIC_SHEETS_API_URL=

# Must match the TOKEN script property you configure in the Apps Script
# (see docs/reservation-setup.md step 4)
NEXT_PUBLIC_SHEETS_API_TOKEN=